{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":enablePreCommit"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:weekly"
    ]
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "The Python builder must match the CPython version in the distroless runtime",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/library/python"],
      "allowedVersions": "/^3\\.13\\./"
    },
    {
      "description": "Buildah images are rebuilt nightly; batch digest updates weekly",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/buildah/stable"],
      "matchUpdateTypes": ["digest"],
      "extends": ["schedule:weekly"],
      "automerge": true
    }
  ]
}
